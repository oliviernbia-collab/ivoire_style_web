# Ivoire Style — site web (public_html de ivoire-style.site)
Options -MultiViews -Indexes
RewriteEngine On

# Fichiers d'état du déploiement continu (FTP) : jamais servis
<FilesMatch "^\.ftp-deploy">
  Require all denied
</FilesMatch>

# HTTPS obligatoire
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://ivoire-style.site%{REQUEST_URI} [L,R=301]

# www.ivoire-style.site -> ivoire-style.site
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ivoire-style.site%{REQUEST_URI} [L,R=301]

# Référencement et aperçus de partage : générés par l'API
RewriteRule ^robots\.txt$ /api/robots.txt [L,R=301]
RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L,R=301]
RewriteRule ^partage/(.*)$ /api/partage/$1 [L,R=301]

# L'API (application Node.js montée sur /api) n'est pas concernée par la suite
RewriteRule ^api(/|$) - [L]

# Application React : toute adresse qui n'est pas un fichier sert index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Fichiers versionnés (nom avec empreinte) : cache long ; index.html : toujours revalidé
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
