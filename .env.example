# URL de l'API. En développement, le proxy Vite redirige /api vers http://localhost:5000
VITE_API_URL=/api/v1
# Préfixe des fichiers (images) ; vide = même origine (proxy)
VITE_FILES_URL=

# Adresse publique du site (URL canoniques et aperçus de partage). Par défaut : l'adresse du navigateur.
VITE_SITE_URL=
